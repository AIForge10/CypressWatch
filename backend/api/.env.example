# Copy to backend/api/.env (never commit it).
DATABASE_URL=postgresql://postgres:password@localhost:5433/cypresswatch

# Auth0 (M1)
# Use the same domain and API identifier/audience as frontend/supervisor/.env.local.
# The API derives its issuer and JWKS URL from AUTH0_DOMAIN unless AUTH0_ISSUER is set.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://api.cypresswatch
AUTH0_ISSUER=
# Local development only: optional absolute path to fresh public JWKS JSON.
# Leave unset in production so the API follows Auth0 signing-key rotation.
AUTH0_JWKS_PATH=
AUTH0_ROLE_CLAIM=https://cypresswatch.app/role
AUTH0_SITE_IDS_CLAIM=https://cypresswatch.app/site_ids
# Post-login Action copies the timestamp of the completed MFA method here.
AUTH0_MFA_AT_CLAIM=https://cypresswatch.app/mfa_at
AUTH0_MFA_MAX_AGE_SECONDS=300

# Vultr Object Storage — S3-compatible (M4)
VULTR_S3_ENDPOINT=
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=
VULTR_S3_BUCKET=cypresswatch

# Gemini (M3) — used for photo triage on upload and score explanations
GEMINI_API_KEY=
