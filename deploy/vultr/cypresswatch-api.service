[Unit]
Description=CypressWatch API (FastAPI + ws)
After=network-online.target
Wants=network-online.target
PartOf=cypresswatch.target

[Service]
Type=simple
User=cypwatch
Group=cypwatch
WorkingDirectory=/opt/cypresswatch/backend/api
EnvironmentFile=/etc/cypresswatch.env
ExecStart=/opt/cypresswatch/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=5
SyslogIdentifier=cypresswatch-api
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/cypresswatch/backend /var/lib/cypresswatch

[Install]
WantedBy=multi-user.target
