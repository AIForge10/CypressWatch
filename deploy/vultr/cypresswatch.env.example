# CypressWatch backend machine settings. Copy to /etc/cypresswatch.env on the VPS.
# systemd reads it for every cypresswatch-* unit. Values here override .env files unless set.

# --- Database: Tiger Data connection string ---
DATABASE_URL=

# --- API identity ---
# Required for all protected API and WebSocket routes. The API derives the
# JWKS URL and issuer from AUTH0_DOMAIN; never add a token or Auth0 client secret here.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://api.cypresswatch
# AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_ROLE_CLAIM=https://cypresswatch.app/role
AUTH0_SITE_IDS_CLAIM=https://cypresswatch.app/site_ids
AUTH0_MFA_AT_CLAIM=https://cypresswatch.app/mfa_at
AUTH0_MFA_MAX_AGE_SECONDS=300

# --- Crew sign-in via DeepSpace ---
# email:site_id|site_id, comma-separated; only these emails get crew access.
CREW_ASSIGNMENTS=
# Demo only: unlisted DeepSpace sign-ins get crew access to these sites (judges). Empty = 403.
CREW_DEMO_SITES=
# Site Beacon bridge key (bridge.py --server ... --key <this>). Generate: python -c 'import secrets;print(secrets.token_urlsafe(24))'
BEACON_KEY=
DEEPSPACE_AUTHORIZED_PARTIES=

# --- AI/ML AI (optional; template fallback without a key) ---
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_BRIEFING_MODEL=gemini-3.8-flash

# --- Workers ---
NASA_FIRMS_MAP_KEY=

# --- Vultr Object Storage, S3-compatible ---
VULTR_S3_ENDPOINT=
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=
VULTR_S3_BUCKET=cypresswatch

# --- Solana ledger ---
# The ledger wallet lives at backend/ledger/.keys/devnet-keypair.json (created by
# `python backend/ledger/cypress_ledger/ledger.py setup` on the server + faucet devnet SOL).
# SOLANA_RPC_URL=https://api.devnet.solana.com
# LEDGER_DB=/var/lib/cypresswatch/ledger.db   (set to keep anchors off the code dir)

# --- Misc ---
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
